# ======================================================================
#  FALCON SMM bot sozlamalari
#  Bu faylni .env ga nusxalang:  cp .env.example .env
#  Keyin quyidagi qiymatlarni O'ZINGIZNIKIGA almashtiring.
#
#  MUHIM QOIDALAR:
#   - '=' belgisi atrofida bo'sh joy QO'YMANG   (to'g'ri: KEY=value)
#   - Qiymatni qo'shtirnoqqa OLMANG             (to'g'ri: KEY=abc123)
#   - Har bir qiymat alohida qatorda bo'lsin
# ======================================================================

# Telegram bot tokeni (BotFather'dan olingan). Format: raqam:harflar
BOT_TOKEN=123456789:ABCdefGhIjKlmNoPqRsTuVwXyZ

# FALCON SMM API kaliti (panel profilingizdan olingan)
FALCON_API_KEY=sizning_api_kalitingiz

# FALCON SMM API manzili (odatda o'zgartirish shart emas)
FALCON_API_URL=https://smmsapi.safobuilder.uz/FalconSeenv2bot/api/v2

# (Ixtiyoriy) Admin Telegram ID. Bir nechta bo'lsa vergul bilan: 111,222
ADMINS=
